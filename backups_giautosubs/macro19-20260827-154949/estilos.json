{
  "_leia": [
    "Estilos do GiAutoSubs. Cada estilo vira inputs de um Text+ do Resolve.",
    "Cores em #RRGGBB. Tamanhos e offsets sao fracao da tela (0..1), como o Fusion usa.",
    "Mapa de elementos do Text+ (1 desenha na frente, 8 mais ao fundo):",
    "  1 fill | 2 outline | 3 sombra do texto | 4 bolha do destaque | 5 sombra da bolha",
    "'destaque' e' a palavra sendo falada agora; 'base' sao todas as outras.",
    "fonte.caixa_das_letras: 'normal' | 'minusculas' | 'maiusculas' (aplicado pelo macro, reversivel).",
    "destaque.caixa.pop: a bolha entra menor e cresce, a cada palavra (o 'pop' do CapCut).",
    "  quantidade esta na escala do extend_h/extend_v; frames e' a duracao da subida.",
    "direcao {x,y}: para onde a sombra cai, em fracao da tela. y NEGATIVO desce",
    "(o eixo do Fusion cresce pra cima). x positivo vai pra direita."
  ],
  "versao": 1,
  "padrao": "capcut_bolha",

  "estilos": {
    "batata_shorts": {
      "fonte": {
        "familia": "Open Sans",
        "estilo": "Bold",
        "tamanho": 0.09
      },
      "posicao": {
        "centro": [0.5, 0.22]
      },
      "quebra": {
        "max_chars": 20,
        "max_linhas": 2
      },

      "base": {
        "fill": {
          "ativo": true,
          "cor": "#FFFFFF"
        },
        "outline": {
          "ativo": true,
          "cor": "#000000",
          "espessura": 0.15,
          "suavidade": 1,
          "direcao": { "x": 0.0, "y": 0.0 }
        },
        "sombra": {
          "ativo": true,
          "cor": "#000000",
          "opacidade": 0.6,
          "suavidade": 1.5,
          "direcao": { "x": 0.004, "y": -0.006 }
        },
        "caixa": {
          "ativo": false,
          "nivel": "linha",
          "cor": "#000000",
          "opacidade": 0.45,
          "extend_h": 0.2,
          "extend_v": 0.12,
          "round": 0.25
        },
        "box_shadow": {
          "ativo": false,
          "cor": "#000000",
          "opacidade": 0.5,
          "suavidade": 2,
          "direcao": { "x": 0.005, "y": -0.007 }
        }
      },

      "destaque": {
        "ativo": true,
        "cor": "#FF4DA6",
        "fill": {
          "ativo": true,
          "cor": "#FF4DA6"
        },
        "caixa": {
          "ativo": false,
          "nivel": "palavra",
          "cor": "#FFD84D",
          "opacidade": 1,
          "extend_h": 0.15,
          "extend_v": 0.1,
          "round": 0.4
        },
        "box_shadow": {
          "ativo": false,
          "cor": "#000000",
          "opacidade": 0.55,
          "suavidade": 2,
          "direcao": { "x": 0.005, "y": -0.007 }
        }
      }
    },

    "capcut_bolha": {
      "_e": "A configuracao ajustada no Inspector em 27/08/2026 e devolvida pelo botao Display Config.",
      "herda": "batata_shorts",
      "fonte": { "caixa_das_letras": "maiusculas" },
      "base": {
        "sombra": { "ativo": false },
        "caixa": { "ativo": false },
        "box_shadow": { "ativo": false }
      },
      "destaque": {
        "fill": { "ativo": true, "cor": "#FFE900" },
        "caixa": {
          "ativo": true,
          "nivel": "palavra",
          "cor": "#000000",
          "opacidade": 1,
          "extend_h": -0.047,
          "extend_v": 0.1,
          "round": 0.126,
          "pop": { "ativo": true, "quantidade": 0.15, "frames": 3 }
        },
        "box_shadow": { "ativo": false }
      }
    },

    "CortesDefault1": {
      "_e": "Clone do capcut_bolha, para os cortes divergirem sem mexer no padrao.",
      "herda": "capcut_bolha"
    },

    "caixa_atras_de_tudo": {
      "herda": "batata_shorts",
      "base": {
        "caixa": { "ativo": true },
        "box_shadow": { "ativo": true }
      }
    }
  },

  "falantes": {
    "Cupertino": { "cor": "#FFD84D", "track": 1 },
    "Heitor":    { "cor": "#4DE1FF", "track": 2 },
    "Giovanni":  { "cor": "#A8FF4D", "track": 3 }
  },

  "_falantes_ajuda": [
    "aplicar_em: 'fill' pinta o TEXTO daquela pessoa (padrao).",
    "             'destaque' pinta a BOLHA dela e deixa o texto no fill do estilo.",
    "track: numero da track de video; omita para todos na mesma."
  ],
  "aplicar_em": "fill"
}
